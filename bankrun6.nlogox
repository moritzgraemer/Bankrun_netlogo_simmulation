<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code>;; ============================================================================
;; BANKRUN ABM - Liquiditaetsmodell mit Ansteckung vs. Heilung
;; ============================================================================
;;
;; &gt;&gt;&gt; DIESE WIDGETS IM INTERFACE-TAB ANLEGEN, SONST LAEUFT DAS MODELL NICHT &lt;&lt;&lt;
;;
;; BUTTONS (Observer):
;;   setup    -&gt; setup        (forever = AUS / once)
;;   go       -&gt; go           (forever = AN)
;;   shock    -&gt; shock        (forever = AUS / once)   ;; Run ausloesen: nach setup klicken
;;
;; SLIDER (Name / min / max / step / default):
;;   ;; --- Netzwerk / Ansteckung ---
;;   num-nodes              10   500   1     200    ;; Anzahl Einleger-Knoten
;;   avg-connections         2    20   1       6    ;; mittlerer Grad (Watts-Strogatz)
;;   beta                    0     1   0.01    0.2   ;; WS-Rewiring (0=Ring, 1=random)
;;   watcher-share           0     1   0.01    0.15  ;; Anteil Watcher (sehen s(l) direkt)
;;   watcher-credibility    0.5    1   0.01    0.9   ;; Glaubwuerdigkeit der Watcher (Einfluss)
;;   risk-threshold         0.05   1   0.01    0.4   ;; Schwelle z. Zustandswechsel; HOCH = stabiler
;;   shock-size              0     1   0.01    0.3   ;; Staerke des Ausloesers
;;   spontaneous-concern     0   0.05  0.001   0.005 ;; normaler Liquiditaetsbedarf (Rauschboden)
;;   ;; --- Bank / Heilung ---
;;   reserve-ratio          0.01  0.5  0.01    0.1   ;; Reservequote r (exogen, Puffer) -- HEATMAP-ACHSE
;;   lolr-cap                0    0.1  0.005   0.02  ;; max. Zentralbank-Kredit pro Tick (Anteil Start-Deposits)
;;   forgetfulness           0    0.5  0.01    0.05  ;; Heilungsrate (Stimmung zurueck + Wiedereinzahlung)
;;
;; SWITCHES (On/Off):
;;   lolr-active?                   On    ;; Lender-of-Last-Resort an/aus
;;   fundamental-shock?             Off   ;; Off = Perception-Schock (Panik), On = echter Liquiditaetsschock
;;   weight-by-credibility-sum?     Off   ;; Off = avg /n , On = avg /Sum(credibility) (Watcher dominieren)
;;
;; MONITORS (optional, aber empfohlen):
;;   frac-withdrawn     signal     liquidity-ratio     bank-alive?
;;
;; PLOT (optional): "States" mit 3 Pens, Update-Command je Pen:
;;   plot frac-calm   |   plot frac-concerned   |   plot frac-withdrawn
;; PLOT (optional): "Bank" mit 2 Pens:
;;   plot liquidity-ratio   |   plot signal
;; ============================================================================
;; NEUE WIDGETS FUER DIVERSITAET &amp; GESCHWINDIGKEIT
;; ============================================================================
;;
;; PLOT "Diversity" (normaler zeitbasierter Plot, X-Achse = ticks):
;;   Pen "avg-entropy"   Update Command: plot avg-opinion-entropy
;;   Y min 0 / Y max 1.585 (= log2(3), theoretisches Maximum)
;;   -&gt; Miss dies NUR im ungeschockten Ruhezustand fuer saubere
;;      avg-connections/beta-Vergleiche (siehe Diskussion: waehrend einer
;;      Kaskade ist der Wert eine Transiente, kein struktureller Fakt)
;;
;; PLOT "Cascade Speed" (X-Achse = ticks-since-shock, NICHT ticks!
;;   Deshalb 'plotxy' statt 'plot' verwenden -- 'plot' wuerde die eigene,
;;   automatisch hochzaehlende Tick-Achse nutzen, nicht ticks-since-shock):
;;   Pen "concerned"   Update Command: if ticks-since-shock &gt;= 0
;;                                       [ plotxy ticks-since-shock frac-concerned ]
;;   Pen "withdraw"    Update Command: if ticks-since-shock &gt;= 0
;;                                       [ plotxy ticks-since-shock frac-withdrawn ]
;;   X min 0 / X max z.B. 500 (anpassen je nach beobachteter Kaskadendauer)
;;   Y min 0 / Y max 1
;;   -&gt; Die STEIGUNG dieser Kurven direkt nach t=0 ist dein Geschwindigkeitsmass;
;;      steilere Anstiege = schnellere Ansteckung fuer die jeweilige Parameterwahl
;;
;; MONITOR (optional, zur Kontrolle waehrend Testlaeufen):
;;   avg-opinion-entropy    ticks-since-shock
;; ============================================================================
;; ============================================================================


globals [
  current-signal     ;; s(l) im aktuellen Tick, [0,1]
  bank-liquidity     ;; l : liquide Mittel der Bank
  bank-deposits      ;; d : Gesamteinlagen in der Bank
  initial-deposits   ;; Referenzwert fuer lolr-cap
  bank-debt          ;; aufgenommener Zentralbank-Kredit
  bank-alive?        ;; absorbierender Todeszustand
  shocked?           ;; NEU: false bis shock-Button gedrueckt wird; sperrt baseline-noise vorher
  ;; dynamic-rewiring?  ;; On: Agenten knuepfen bei Eskalation neue Kontakte
  shock-tick        ;; NEU: Tick des ERSTEN Schocks, -1 = noch kein Schock erfolgt
  peak-withdrawn    ;; NEU: Maximum von frac-withdrawn ueber den gesamten Lauf
]

turtles-own [
  state              ;; "calm" | "concerned" | "withdraw"
  deposit-i          ;; Einlage dieses Agenten in der Bank
  cash-held          ;; abgehobenes Geld, das der Agent bei sich haelt
  credibility        ;; [0,1] -&gt; Knotengroesse / Einfluss
  watcher?           ;; true = empfaengt s(l) direkt
  naivety-concerned  ;; untere Schwelle (calm -&gt; concerned)
  naivety-withdraw   ;; obere Schwelle (concerned -&gt; withdraw)
]


;;;;;;;;;;;;;;;;;;;;;;;
;;;     SETUP      ;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  set-default-shape turtles "circle"

  ;; --- Agenten erzeugen, RANDOM ueber die Karte verteilt ---
  create-turtles num-nodes [
    setxy random-xcor random-ycor
    set state "calm"
    set deposit-i 0.5 + random-float 1.5          ;; Wealth-Heterogenitaet
    set cash-held 0
    set watcher? (random-float 1 &lt; watcher-share)
    ifelse watcher?
      [ set credibility watcher-credibility + random-float (1 - watcher-credibility)
        set shape "target" ]                      
      [ set credibility random-float 0.5
        set shape "circle" ]  
    ;; heterogene Schwellen, skaliert mit risk-threshold; concerned &lt; withdraw
    set naivety-concerned risk-threshold * (0.5 + random-float 0.5)
    set naivety-withdraw  naivety-concerned + (1 - naivety-concerned) * (0.2 + random-float 0.6)
    set size 0.5 + credibility
  ]

  build-network

  ;; --- Bankbilanz initialisieren: l = r * d, Signal = 0 ---
  set bank-deposits   sum [deposit-i] of turtles
  set initial-deposits bank-deposits
  set bank-liquidity  reserve-ratio * bank-deposits
  set bank-debt       0
  set current-signal  0
  set bank-alive?     true
  set shocked?        false  ;; NEU: System startet im stabilen Zustand
  set shock-tick  -1
  set peak-withdrawn  0      ;; NEU: Peak-Tracking zuruecksetzen

  recolor
  reset-ticks
end

;; Ring-Gitter ueber den INDEX (who) + WS-Rewiring.
;; Die Position auf der Karte ist random -&gt; rein visuell; die Topologie bleibt Watts-Strogatz.
to build-network
  let half floor (avg-connections / 2)
  ask turtles [
    let id who
    let i 1
    while [i &lt;= half] [
      create-link-with turtle ((id + i) mod num-nodes)
      set i i + 1
    ]
  ]
  ;; zufaelliges Rewiring mit Wahrscheinlichkeit beta
  ask links [
    if random-float 1 &lt; beta [
      let keep-end one-of both-ends
      let candidates turtles with [self != keep-end and not link-neighbor? keep-end]
      if any? candidates [
        ask keep-end [ create-link-with one-of candidates ]
        die
      ]
    ]
  ]
  ask links [ set color gray ]
  ;; Federlayout zur besseren Visualisierung
  repeat 100 [
    layout-spring turtles links 0.2 8 2
    display
  ]
  ;; Knoten Richtung Mitte skalieren

  ask turtles [

    setxy (xcor * 0.8) (ycor * 0.8)

  ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;      GO       ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Tick-Reihenfolge: Signal -&gt; normaler Bedarf -&gt; Agenten entscheiden
;;                   -&gt; Bank managt Liquiditaet (LoLR / Tod / Rueckzahlung)
to go
  if not bank-alive? [ stop ]
  update-signal
  baseline-noise
  agents-decide
  bank-manage-liquidity
  recolor
  tick
end

;; ============================================================================
;; GO FUER BEHAVIORSPACE (unbeaufsichtigt, deterministischer Schock bei t=0)
;; Interface-`go` bleibt unangetastet; Experimente nutzen `go-exp`.
;; Der Schock feuert automatisch beim Tick `warmup-ticks` -&gt; flache Baseline t&lt;0,
;; danach zaehlt `ticks-since-shock` sauber ab 0.
;; ============================================================================
to go-exp
  if not bank-alive? [ stop ]
  if ticks = warmup-ticks [ shock ]        ;; deterministischer t=0-Schock
  update-signal
  baseline-noise
  agents-decide
  bank-manage-liquidity
  if frac-withdrawn &gt; peak-withdrawn [ set peak-withdrawn frac-withdrawn ]  ;; Peak-Tracking
  recolor
  tick
end

;; ============================================================================
;; GO FUER DIE EVENT-STUDY (Experiment 2, runMetricsEveryStep=true)
;; WICHTIG: hier KEIN "stop" bei Tod. Die tote Bank wird eingefroren und der
;; Lauf tickt bis zum Fensterende weiter (In-Model-Carry-Forward), damit
;; ticks-since-shock die Exit-Bedingung (&gt;= 200) sicher erreicht und jeder Lauf
;; gleich lange Zeitreihen liefert. Wuerde man go-exp nutzen, blieben tote
;; Laeufe stehen -&gt; BehaviorSpace haengt.
;; ============================================================================
to go-event
  if ticks = warmup-ticks [ shock ]        ;; deterministischer t=0-Schock
  if bank-alive? [
    update-signal
    baseline-noise
    agents-decide
    bank-manage-liquidity
    if frac-withdrawn &gt; peak-withdrawn [ set peak-withdrawn frac-withdrawn ]
    recolor
  ]
  ;; Bank tot -&gt; Zustand eingefroren, Metriken tragen den Terminalwert weiter
  tick
end

;; s(l) = (r - l/d) / r , gekappt auf [0,1]
to update-signal
  ifelse bank-deposits &gt; 0
    [ set current-signal (reserve-ratio - (bank-liquidity / bank-deposits)) / reserve-ratio ]
    [ set current-signal 1 ]
  set current-signal max (list 0 (min (list 1 current-signal)))
end

;; normaler Liquiditaetsbedarf: kleine Chance, dass ruhige Agenten besorgt werden (Rauschboden)
;; NEU: laeuft nur nach dem Schock (shocked? = true), davor bleibt das System eingefroren
to baseline-noise
  ;; if not shocked? [ stop ]  ;; deaktiviert: Rauschen laeuft auch vor dem Schock (bewusste Entscheidung)
  ask turtles with [state = "calm"] [
    if random-float 1 &lt; spontaneous-concern [ set-state "concerned" ]
  ]
end

;; Eskalation ueber Schwellen, De-Eskalation NUR stochastisch (Hysterese).
;; Alle Agenten sehen dasselbe Signal vom Tick-Anfang.
;; Eskalation ueber Schwellen (Vorrang), De-Eskalation stochastisch UND UNABHAENGIG vom Signal.
;; NEU: forgetfulness wirkt jetzt auch, wenn perceived noch hoch ist ("echte" Vergesslichkeit,
;;      nicht mehr an perceived &lt; naivety-concerned gekoppelt).
to agents-decide
  ask turtles [
    let perceived perceived-signal
    let escalated? false

    ifelse perceived &gt;= naivety-withdraw [
      if state != "withdraw" [
        become-withdraw
        seek-connection
        set escalated? true
      ]
    ] [
      if perceived &gt;= naivety-concerned [
        if state = "calm" [
          set-state "concerned"
          seek-connection
          set escalated? true
        ]
      ]
    ]

    ;; Vergesslichkeit: unabhaengig von perceived, aber nur wenn in diesem Tick
    ;; keine Eskalation stattgefunden hat (Eskalation hat Vorrang).
    if not escalated? [
      if random-float 1 &lt; forgetfulness [ step-down ]
    ]
  ]
end


to seek-connection
  if not dynamic-rewiring? [ stop ]
  if random-float 1 &lt; beta [
    let candidates other turtles with [not link-neighbor? myself]
    if any? candidates [
      create-link-with one-of candidates [ set color yellow ]
    ]
  ]
end

;; wahrgenommenes Signal: sozialer Nachbar-Durchschnitt;
;; Watcher hoeren zusaetzlich die Bank (= extra hoch-glaubwuerdiger "Nachbar" mit s(l))
to-report perceived-signal
  let total 0
  let wsum 0
  let cnt 0
  ask link-neighbors [
    set total total + (signal-of state) * credibility
    set wsum wsum + credibility
    set cnt cnt + 1
  ]
  if watcher? [
    set total total + current-signal * credibility
    set wsum wsum + credibility
    set cnt cnt + 1
  ]
  if cnt = 0 [ report 0 ]
  ifelse weight-by-credibility-sum?
    [ ifelse wsum &gt; 0 [ report total / wsum ] [ report 0 ] ]
    [ report total / cnt ]
end

to-report signal-of [s]
  if s = "calm"      [ report 0 ]
  if s = "concerned" [ report 0.5 ]
  report 1   ;; "withdraw"
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;  GELDFLUESSE   ;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Abheben: Einlage wandert in cash-held, Bank zahlt aus
to become-withdraw
  set cash-held      cash-held + deposit-i
  set bank-liquidity bank-liquidity - deposit-i
  set bank-deposits  bank-deposits - deposit-i
  set deposit-i      0
  set-state "withdraw"
end

;; Wiedereinzahlung (beim Beruhigen): Geld zurueck zur Bank
to redeposit
  set bank-liquidity bank-liquidity + cash-held
  set bank-deposits  bank-deposits + cash-held
  set deposit-i      cash-held
  set cash-held      0
end

;; einen Zustand zurueck; beim Verlassen von "withdraw" wird wieder eingezahlt
to step-down
  ifelse state = "withdraw"
    [ redeposit  set-state "concerned" ]
    [ if state = "concerned" [ set-state "calm" ] ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;     BANK      ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; LoLR fuellt l bis zum Ziel r*d auf (begrenzt pro Tick); Tod bei l&lt;0;
;; Zwei-Wege-Ventil: Ueberschuss zahlt Kredit zurueck
to bank-manage-liquidity
  let target reserve-ratio * bank-deposits

  if lolr-active? and bank-liquidity &lt; target [
    let need   target - bank-liquidity
    let cap    lolr-cap * initial-deposits
    let borrow min (list need cap)
    set bank-liquidity bank-liquidity + borrow
    set bank-debt      bank-debt + borrow
  ]

  ;; Abhebungen konnten nicht gedeckt werden -&gt; Bank stirbt (absorbierend)
  if bank-liquidity &lt; 0 [ set bank-alive? false ]

  ;; l ueber Ziel -&gt; Geld zurueck an Zentralbank
  if bank-liquidity &gt; target [
    let excess bank-liquidity - target
    let repay  min (list excess bank-debt)
    set bank-liquidity bank-liquidity - repay
    set bank-debt      bank-debt - repay
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;   AUSLOESER   ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Run ausloesen (Button "shock"). Toggle fundamental-shock? entscheidet den Typ:
;;   Off (perception): Geruecht trifft einige Watcher -&gt; Panik, Fundamental intakt
;;   On  (fundamental): echter Liquiditaetsverlust -&gt; s(l) steigt real
to shock
  if shock-tick = -1 [ set shock-tick ticks ]   ;; NEU: fixiert t=0 fuer die Geschwindigkeitsmessung
  set shocked? true
  ifelse fundamental-shock? [
    set bank-liquidity bank-liquidity - shock-size * reserve-ratio * bank-deposits
  ] [
    let n-shock round (shock-size * count turtles with [watcher?])
    if n-shock &gt; 0 [
      ask n-of n-shock turtles with [watcher?] [ become-withdraw ]
    ]
  ]
  recolor
end

;;;;;;;;;;;;;;;;;;;;;;;
;;;  DARSTELLUNG  ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to set-state [s]
  set state s
end

to recolor
  ask turtles [
    if state = "calm"      [ set color blue ]
    if state = "concerned" [ set color orange ]
    if state = "withdraw"  [ set color red ]
  ]
end



;;;;;;;;;;;;;;;;;;;;;;;
;;;   REPORTER    ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to-report frac-calm      report count turtles with [state = "calm"]      / count turtles end
to-report frac-concerned report count turtles with [state = "concerned"] / count turtles end
to-report frac-withdrawn report count turtles with [state = "withdraw"]  / count turtles end
to-report signal         report current-signal end
to-report liquidity-ratio
  ifelse bank-deposits &gt; 0 [ report bank-liquidity / bank-deposits ] [ report 0 ]
end

to-report avg-opinion-entropy
  let connected turtles with [count link-neighbors &gt; 0]
  ifelse any? connected
    [ report mean [opinion-entropy] of connected ]
    [ report 0 ]
end

;; ---- GESCHWINDIGKEIT ----
;; Ticks seit dem ERSTEN Schock; -1 solange noch kein Schock ausgeloest wurde.
;; Als X-Achse fuer den Kaskaden-Plot nutzen, NICHT den rohen ticks-Zaehler,
;; damit Laeufe mit unterschiedlichem Schock-Zeitpunkt vergleichbar bleiben.
to-report ticks-since-shock
  ifelse shock-tick = -1 [ report -1 ] [ report ticks - shock-tick ]
end
  
;; ---- DIVERSITAET ----
;; Shannon-Entropie ueber die Zustandsverteilung der eigenen Nachbarn.
;; 0 = alle Nachbarn im selben Zustand (homogen/keine Diversitaet)
;; log2(3) ~ 1.585 = maximal divers (Nachbarn gleichmaessig auf calm/concerned/withdraw verteilt)
to-report opinion-entropy
  let n count link-neighbors
  if n = 0 [ report 0 ]
  let counts (list
    count link-neighbors with [state = "calm"]
    count link-neighbors with [state = "concerned"]
    count link-neighbors with [state = "withdraw"])
  let h 0
  foreach counts [ c -&gt;
    if c &gt; 0 [
      let p c / n
      set h h - (p * ln p / ln 2)
    ]
  ]
  report h
end
</code>
  <widgets>
    <view x="835" wrappingAllowedX="false" y="0" frameRate="30.0" minPycor="-16" height="584" showTickCounter="true" patchSize="17.6" fontSize="10" wrappingAllowedY="false" width="584" tickCounterLabel="Zeittakte" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16" />
    <button x="25" actionKey="S" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="61">setup</button>
    <monitor x="360" precision="17" y="70" height="60" fontSize="11" width="100">bank-alive?</monitor>
    <monitor x="360" precision="17" y="130" height="60" fontSize="11" width="100">liquidity-ratio</monitor>
    <monitor x="460" precision="17" y="70" height="60" fontSize="11" width="100">frac-withdrawn</monitor>
    <monitor x="460" precision="3" y="130" height="60" fontSize="11" width="100" display="signal /health">1 - signal</monitor>
    <plot x="590" autoPlotX="true" yMax="1.0" autoPlotY="true" y="195" xMin="0.0" height="225" legend="true" xMax="10.0" yMin="0.0" width="230" display="Bank">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="liquidity/illiquid ratio" color="-11085214" legend="true">
        <setup />
        <update>plot liquidity-ratio</update>
      </pen>
      <pen interval="1.0" mode="0" display="signal" color="-2139308" legend="true">
        <setup />
        <update>plot signal</update>
      </pen>
    </plot>
    <plot x="360" autoPlotX="true" yMax="1.0" autoPlotY="false" yAxis="%" y="195" xMin="0.0" height="250" legend="true" xMax="10.0" yMin="0.0" width="230" display="States">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="frac calm" color="-13345367" legend="true">
        <setup />
        <update>plot frac-calm</update>
      </pen>
      <pen interval="1.0" mode="0" display="frac concerned" color="-955883" legend="true">
        <setup />
        <update>plot frac-concerned</update>
      </pen>
      <pen interval="1.0" mode="0" display="frac withdraw" color="-2674135" legend="true">
        <setup />
        <update>plot frac-withdrawn</update>
      </pen>
    </plot>
    <slider x="25" step="0.01" y="320" max="1" width="250" display="risk-threshold" height="50" min="0.05" direction="Horizontal" default="0.82" variable="risk-threshold" />
    <slider x="25" step="0.01" y="370" max="0.5" width="250" display="forgetfulness" height="50" min="0" direction="Horizontal" default="0.22" variable="forgetfulness" />
    <slider x="25" step="0.001" y="420" max="0.5" width="250" display="spontaneous-concern" height="50" min="0" direction="Horizontal" default="0.016" variable="spontaneous-concern" />
    <slider x="25" step="0.01" y="470" max="1" width="250" display="reserve-ratio" height="50" min="0.01" direction="Horizontal" default="0.01" variable="reserve-ratio" />
    <slider x="25" step="0.005" y="520" max="0.1" width="250" display="lolr-cap" height="50" min="0" direction="Horizontal" default="0.001" variable="lolr-cap" />
    <switch x="605" y="550" height="40" on="true" variable="fundamental-shock?" width="165" display="fundamental-shock?" />
    <switch x="605" y="590" height="40" on="true" variable="weight-by-credibility-sum?" width="185" display="weight-by-credibility-sum?" />
    <switch x="605" y="510" height="40" on="false" variable="dynamic-rewiring?" width="145" display="dynamic-rewiring?" />
    <switch x="605" y="470" height="40" on="true" variable="lolr-active?" width="100" display="lolr-active?" />
    <slider x="25" step="0.01" y="570" max="1" width="250" display="shock-size" height="50" min="0" direction="Horizontal" default="0.34" variable="shock-size" />
    <slider x="25" step="1" y="625" max="200" width="250" display="warmup-ticks" height="50" min="0" direction="Horizontal" default="25.0" variable="warmup-ticks" />
    <monitor x="360" precision="17" y="560" height="60" fontSize="11" width="100">frac-withdrawn</monitor>
    <monitor x="360" precision="17" y="505" height="60" fontSize="11" width="100">frac-concerned</monitor>
    <monitor x="360" precision="17" y="445" height="60" fontSize="11" width="112">frac-calm</monitor>
    <button x="95" actionKey="G" y="15" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="65">go
</button>
    <button x="170" actionKey="X" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="61">shock</button>
    <slider x="25" step="1" y="70" max="500" width="250" display="num-nodes" height="50" min="10" direction="Horizontal" default="200.0" variable="num-nodes" />
    <slider x="25" step="1" y="120" max="20" width="250" display="avg-connections" height="50" min="2" direction="Horizontal" default="13.0" variable="avg-connections" />
    <slider x="25" step="0.01" y="170" max="1" width="250" display="beta" height="50" min="0" direction="Horizontal" default="0.14" variable="beta" />
    <slider x="25" step="0.01" y="270" max="1" width="250" display="watcher-credibility" height="50" min="0.5" direction="Horizontal" default="0.7" variable="watcher-credibility" />
    <slider x="25" step="0.01" y="220" max="1" width="250" display="watcher-share" height="50" min="0" direction="Horizontal" default="0.05" variable="watcher-share" />
    <plot x="520" autoPlotX="true" yMax="1.585" autoPlotY="true" y="690" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Diversity">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="avg-entropy" color="-16777216" legend="true">
        <setup />
        <update>plot avg-opinion-entropy</update>
      </pen>
    </plot>
    <plot x="785" autoPlotX="true" yMax="1.0" autoPlotY="true" y="690" xMin="0.0" height="175" legend="false" xMax="1.0" yMin="0.0" width="230" display="Cascade Speed">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="concerned" color="-955883" legend="true">
        <setup />
        <update>if ticks-since-shock &gt;= 0 [ plotxy ticks-since-shock frac-concerned ]</update>
      </pen>
      <pen interval="1.0" mode="0" display="withdraw" color="-2674135" legend="true">
        <setup />
        <update>if ticks-since-shock &gt;= 0 [ plotxy ticks-since-shock frac-withdrawn ]</update>
      </pen>
    </plot>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)

## NETLOGO FEATURES

(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)

## RELATED MODELS

(models in the NetLogo Models Library and elsewhere which are of related interest)

## CREDITS AND REFERENCES

(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)
</info>
