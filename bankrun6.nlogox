  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="degree_vs_lethality" repetitions="50" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go-exp</go>
      <exitCondition>not bank-alive? or ticks-since-shock &gt;= 400</exitCondition>
      <metrics>
        <metric>bank-alive?</metric>
        <metric>ticks-since-shock</metric>
        <metric>peak-withdrawn</metric>
        <metric>frac-withdrawn</metric>
        <metric>frac-concerned</metric>
        <metric>liquidity-ratio</metric>
        <metric>count links / count turtles</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="avg-connections" first="2" step="1" last="20" />
        <enumeratedValueSet variable="reserve-ratio">
          <value value="0.02" /><value value="0.04" /><value value="0.06" /></enumeratedValueSet>
        <enumeratedValueSet variable="fundamental-shock?">
          <value value="false" />
          <value value="true" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="lolr-active?">
          <value value="true" />
          <value value="false" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-nodes">
          <value value="200" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="beta">
          <value value="0.1" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="watcher-share">
          <value value="0.05" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="watcher-credibility">
          <value value="0.9" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="risk-threshold">
          <value value="0.2" /></enumeratedValueSet>
        <enumeratedValueSet variable="shock-size">
          <value value="0.6" /></enumeratedValueSet>
        <enumeratedValueSet variable="spontaneous-concern">
          <value value="0.005" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="lolr-cap">
          <value value="0.01" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="forgetfulness">
          <value value="0.02" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="warmup-ticks">
          <value value="25" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="dynamic-rewiring?">
          <value value="false" />
        </enumeratedValueSet>
        <enumeratedValueSet variable="weight-by-credibility-sum?">
          <value value="false" />
        </enumeratedValueSet>
      </constants>
    </experiment>
