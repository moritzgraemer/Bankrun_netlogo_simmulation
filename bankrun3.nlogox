</button>
    <button x="165" y="20" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">shock</button>
    <slider x="25" step="1" y="70" max="500" width="250" display="num-nodes" height="50" min="10" direction="Horizontal" default="191.0" variable="num-nodes"></slider>
    <slider x="25" step="1" y="120" max="20" width="250" display="avg-connections" height="50" min="2" direction="Horizontal" default="6.0" variable="avg-connections"></slider>
