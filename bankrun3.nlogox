    <slider x="25" step="0.01" y="270" max="1" width="250" display="watcher-credibility" height="50" min="0.5" direction="Horizontal" default="0.63" variable="watcher-credibility"></slider>
    <slider x="25" step="0.01" y="320" max="1" width="250" display="risk-threshold" height="50" min="0.05" direction="Horizontal" default="0.29" variable="risk-threshold"></slider>
    <slider x="25" step="0.01" y="370" max="1" width="250" display="shock-size" height="50" min="0" direction="Horizontal" default="0.03" variable="shock-size"></slider>
    <slider x="25" step="0.01" y="420" max="1" width="250" display="reserve-ratio" height="50" min="0.01" direction="Horizontal" default="0.59" variable="reserve-ratio"></slider>
    <slider x="25" step="0.005" y="465" max="0.1" width="250" display="lolr-cap" height="50" min="0" direction="Horizontal" default="0.06" variable="lolr-cap"></slider>
    <slider x="25" step="0.01" y="515" max="0.5" width="250" display="forgetfulness" height="50" min="0" direction="Horizontal" default="0.26" variable="forgetfulness"></slider>
    <switch x="370" y="515" height="40" on="true" variable="fundamental-shock?" width="165" display="fundamental-shock?"></switch>
    <slider x="25" step="0.001" y="565" max="0.5" width="250" display="spontaneous-concern" height="50" min="0" direction="Horizontal" default="0.05" variable="spontaneous-concern"></slider>
    <switch x="370" y="555" height="40" on="true" variable="weight-by-credibility-sum?" width="185" display="weight-by-credibility-sum?"></switch>
    <switch x="370" y="475" height="40" on="true" variable="lolr-active?" width="100" display="lolr-active?"></switch>
    <monitor x="360" precision="17" y="70" height="60" fontSize="11" width="100">bank-alive?</monitor>
    <monitor x="360" precision="17" y="130" height="60" fontSize="11" width="100">liquidity-ratio</monitor>
    <monitor x="460" precision="17" y="70" height="60" fontSize="11" width="100">frac-withdrawn</monitor>
    <monitor x="460" precision="17" y="130" height="60" fontSize="11" width="100">signal</monitor>
    <plot x="360" autoPlotX="true" yMax="10.0" autoPlotY="true" y="195" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="States">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-13345367" legend="true">
        <setup></setup>
        <update>plot frac-calm</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-1" color="-955883" legend="true">
        <setup></setup>
        <update>plot frac-concerned</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-2" color="-2674135" legend="true">
        <setup></setup>
        <update>plot frac-withdrawn</update>
      </pen>
    </plot>
    <plot x="590" autoPlotX="true" yMax="10.0" autoPlotY="true" y="195" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Bank">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-11085214" legend="true">
        <setup></setup>
        <update>plot liquidity-ratio</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-1" color="-2139308" legend="true">
        <setup></setup>
        <update>plot signal</update>
      </pen>
    </plot>
  </widgets>
