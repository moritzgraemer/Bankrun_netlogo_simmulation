<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ============================================================================
;; BANKRUN ABM - Liquiditaetsmodell mit Ansteckung vs. Heilung
;; ============================================================================
;;
;; >>> DIESE WIDGETS IM INTERFACE-TAB ANLEGEN, SONST LAEUFT DAS MODELL NICHT <<<
;;
;; BUTTONS (Observer):
;;   setup    -> setup        (forever = AUS / once)
;;   go       -> go           (forever = AN)
;;   shock    -> shock        (forever = AUS / once)   ;; Run ausloesen: nach setup klicken
;;
;; SLIDER (Name / min / max / step / default):
;;   ;; --- Netzwerk / Ansteckung ---
;;   num-nodes              10   500   1     200    ;; Anzahl Einleger-Knoten
;;   avg-connections         2    20   1       6    ;; mittlerer Grad (Watts-Strogatz)
;;   beta                    0     1   0.01    0.2   ;; WS-Rewiring (0=Ring, 1=random)
;;   watcher-share           0     1   0.01    0.15  ;; Anteil Watcher (sehen s(l) direkt)
;;   watcher-credibility    0.5    1   0.01    0.9   ;; Glaubwuerdigkeit der Watcher (Einfluss)
;;   risk-threshold         0.05   1   0.01    0.4   ;; Schwelle z. Zustandswechsel; HOCH = stabiler
;;   shock-size              0     1   0.01    0.3   ;; Staerke des Ausloesers
;;   spontaneous-concern     0   0.05  0.001   0.005 ;; normaler Liquiditaetsbedarf (Rauschboden)
;;   ;; --- Bank / Heilung ---
;;   reserve-ratio          0.01  0.5  0.01    0.1   ;; Reservequote r (exogen, Puffer) -- HEATMAP-ACHSE
;;   lolr-cap                0    0.1  0.005   0.02  ;; max. Zentralbank-Kredit pro Tick (Anteil Start-Deposits)
;;   forgetfulness           0    0.5  0.01    0.05  ;; Heilungsrate (Stimmung zurueck + Wiedereinzahlung)
;;
;; SWITCHES (On/Off):
;;   lolr-active?                   On    ;; Lender-of-Last-Resort an/aus
;;   fundamental-shock?             Off   ;; Off = Perception-Schock (Panik), On = echter Liquiditaetsschock
;;   weight-by-credibility-sum?     Off   ;; Off = avg /n , On = avg /Sum(credibility) (Watcher dominieren)
;;
;; MONITORS (optional, aber empfohlen):
;;   frac-withdrawn     signal     liquidity-ratio     bank-alive?
;;
;; PLOT (optional): "States" mit 3 Pens, Update-Command je Pen:
;;   plot frac-calm   |   plot frac-concerned   |   plot frac-withdrawn
;; PLOT (optional): "Bank" mit 2 Pens:
;;   plot liquidity-ratio   |   plot signal
;; ============================================================================


globals [
  current-signal     ;; s(l) im aktuellen Tick, [0,1]
  bank-liquidity     ;; l : liquide Mittel der Bank
  bank-deposits      ;; d : Gesamteinlagen in der Bank
  initial-deposits   ;; Referenzwert fuer lolr-cap
  bank-debt          ;; aufgenommener Zentralbank-Kredit
  bank-alive?        ;; absorbierender Todeszustand
]

turtles-own [
  state              ;; "calm" | "concerned" | "withdraw"
  deposit-i          ;; Einlage dieses Agenten in der Bank
  cash-held          ;; abgehobenes Geld, das der Agent bei sich haelt
  credibility        ;; [0,1] -> Knotengroesse / Einfluss
  watcher?           ;; true = empfaengt s(l) direkt
  naivety-concerned  ;; untere Schwelle (calm -> concerned)
  naivety-withdraw   ;; obere Schwelle (concerned -> withdraw)
]


;;;;;;;;;;;;;;;;;;;;;;;
;;;     SETUP      ;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  set-default-shape turtles "circle"

  ;; --- Agenten erzeugen, RANDOM ueber die Karte verteilt ---
  create-turtles num-nodes [
    setxy random-xcor random-ycor
    set state "calm"
    set deposit-i 0.5 + random-float 1.5          ;; Wealth-Heterogenitaet
    set cash-held 0
    set watcher? (random-float 1 < watcher-share)
    ifelse watcher?
      [ set credibility watcher-credibility + random-float (1 - watcher-credibility) ]
      [ set credibility random-float 0.5 ]
    ;; heterogene Schwellen, skaliert mit risk-threshold; concerned < withdraw
    set naivety-concerned risk-threshold * (0.5 + random-float 0.5)
    set naivety-withdraw  naivety-concerned + (1 - naivety-concerned) * (0.2 + random-float 0.6)
    set size 0.5 + credibility
  ]

  build-network

  ;; --- Bankbilanz initialisieren: l = r * d, Signal = 0 ---
  set bank-deposits   sum [deposit-i] of turtles
  set initial-deposits bank-deposits
  set bank-liquidity  reserve-ratio * bank-deposits
  set bank-debt       0
  set current-signal  0
  set bank-alive?     true

  recolor
  reset-ticks
end

;; Ring-Gitter ueber den INDEX (who) + WS-Rewiring.
;; Die Position auf der Karte ist random -> rein visuell; die Topologie bleibt Watts-Strogatz.
to build-network
  let half floor (avg-connections / 2)
  ask turtles [
    let id who
    let i 1
    while [i <= half] [
      create-link-with turtle ((id + i) mod num-nodes)
      set i i + 1
    ]
  ]
  ;; zufaelliges Rewiring mit Wahrscheinlichkeit beta
  ask links [
    if random-float 1 < beta [
      let keep-end one-of both-ends
      let candidates turtles with [self != keep-end and not link-neighbor? keep-end]
      if any? candidates [
        ask keep-end [ create-link-with one-of candidates ]
        die
      ]
    ]
  ]
  ask links [ set color gray ]
  ;; Federlayout zur besseren Visualisierung
  repeat 100 [
    layout-spring turtles links 0.3 5 1
    display
  ]
  ;; Knoten Richtung Mitte skalieren

  ask turtles [
    
    setxy (xcor * 0.8) (ycor * 0.8)
    
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;      GO       ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Tick-Reihenfolge: Signal -> normaler Bedarf -> Agenten entscheiden
;;                   -> Bank managt Liquiditaet (LoLR / Tod / Rueckzahlung)
to go
  if not bank-alive? [ stop ]
  update-signal
  baseline-noise
  agents-decide
  bank-manage-liquidity
  recolor
  tick
end

;; s(l) = (r - l/d) / r , gekappt auf [0,1]
to update-signal
  ifelse bank-deposits > 0
    [ set current-signal (reserve-ratio - (bank-liquidity / bank-deposits)) / reserve-ratio ]
    [ set current-signal 1 ]
  set current-signal max (list 0 (min (list 1 current-signal)))
end

;; normaler Liquiditaetsbedarf: kleine Chance, dass ruhige Agenten besorgt werden (Rauschboden)
to baseline-noise
  ask turtles with [state = "calm"] [
    if random-float 1 < spontaneous-concern [ set-state "concerned" ]
  ]
end

;; Eskalation ueber Schwellen, De-Eskalation NUR stochastisch (Hysterese).
;; Alle Agenten sehen dasselbe Signal vom Tick-Anfang.
to agents-decide
  ask turtles [
    let perceived perceived-signal
    ifelse perceived >= naivety-withdraw [
      if state != "withdraw" [ become-withdraw ]
    ] [
      ifelse perceived >= naivety-concerned [
        if state = "calm" [ set-state "concerned" ]   ;; withdraw bleibt sticky
      ] [
        ;; Signal niedrig -> Heilung: mit forgetfulness einen Zustand zurueck
        if random-float 1 < forgetfulness [ step-down ]
      ]
    ]
  ]
end

;; wahrgenommenes Signal: sozialer Nachbar-Durchschnitt;
;; Watcher hoeren zusaetzlich die Bank (= extra hoch-glaubwuerdiger "Nachbar" mit s(l))
to-report perceived-signal
  let total 0
  let wsum 0
  let cnt 0
  ask link-neighbors [
    set total total + (signal-of state) * credibility
    set wsum wsum + credibility
    set cnt cnt + 1
  ]
  if watcher? [
    set total total + current-signal * credibility
    set wsum wsum + credibility
    set cnt cnt + 1
  ]
  if cnt = 0 [ report 0 ]
  ifelse weight-by-credibility-sum?
    [ ifelse wsum > 0 [ report total / wsum ] [ report 0 ] ]
    [ report total / cnt ]
end

to-report signal-of [s]
  if s = "calm"      [ report 0 ]
  if s = "concerned" [ report 0.5 ]
  report 1   ;; "withdraw"
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;  GELDFLUESSE   ;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Abheben: Einlage wandert in cash-held, Bank zahlt aus
to become-withdraw
  set cash-held      cash-held + deposit-i
  set bank-liquidity bank-liquidity - deposit-i
  set bank-deposits  bank-deposits - deposit-i
  set deposit-i      0
  set-state "withdraw"
end

;; Wiedereinzahlung (beim Beruhigen): Geld zurueck zur Bank
to redeposit
  set bank-liquidity bank-liquidity + cash-held
  set bank-deposits  bank-deposits + cash-held
  set deposit-i      cash-held
  set cash-held      0
end

;; einen Zustand zurueck; beim Verlassen von "withdraw" wird wieder eingezahlt
to step-down
  ifelse state = "withdraw"
    [ redeposit  set-state "concerned" ]
    [ if state = "concerned" [ set-state "calm" ] ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;     BANK      ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; LoLR fuellt l bis zum Ziel r*d auf (begrenzt pro Tick); Tod bei l<0;
;; Zwei-Wege-Ventil: Ueberschuss zahlt Kredit zurueck
to bank-manage-liquidity
  let target reserve-ratio * bank-deposits

  if lolr-active? and bank-liquidity < target [
    let need   target - bank-liquidity
    let cap    lolr-cap * initial-deposits
    let borrow min (list need cap)
    set bank-liquidity bank-liquidity + borrow
    set bank-debt      bank-debt + borrow
  ]

  ;; Abhebungen konnten nicht gedeckt werden -> Bank stirbt (absorbierend)
  if bank-liquidity < 0 [ set bank-alive? false ]

  ;; l ueber Ziel -> Geld zurueck an Zentralbank
  if bank-liquidity > target [
    let excess bank-liquidity - target
    let repay  min (list excess bank-debt)
    set bank-liquidity bank-liquidity - repay
    set bank-debt      bank-debt - repay
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;   AUSLOESER   ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Run ausloesen (Button "shock"). Toggle fundamental-shock? entscheidet den Typ:
;;   Off (perception): Geruecht trifft einige Watcher -> Panik, Fundamental intakt
;;   On  (fundamental): echter Liquiditaetsverlust -> s(l) steigt real
to shock
  ifelse fundamental-shock? [
    set bank-liquidity bank-liquidity - shock-size * reserve-ratio * bank-deposits
  ] [
    let n-shock round (shock-size * count turtles with [watcher?])
    if n-shock > 0 [
      ask n-of n-shock turtles with [watcher?] [ become-withdraw ]
    ]
  ]
  recolor
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;  DARSTELLUNG  ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to set-state [s]
  set state s
end

to recolor
  ask turtles [
    if state = "calm"      [ set color blue ]
    if state = "concerned" [ set color orange ]
    if state = "withdraw"  [ set color red ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;;
;;;   REPORTER    ;;;;;
;;;;;;;;;;;;;;;;;;;;;;;

to-report frac-calm      report count turtles with [state = "calm"]      / count turtles end
to-report frac-concerned report count turtles with [state = "concerned"] / count turtles end
to-report frac-withdrawn report count turtles with [state = "withdraw"]  / count turtles end
to-report signal         report current-signal end
to-report liquidity-ratio
  ifelse bank-deposits > 0 [ report bank-liquidity / bank-deposits ] [ report 0 ]
end
]]></code>
  <widgets>
    <view x="835" wrappingAllowedX="true" y="0" frameRate="30.0" minPycor="-16" height="584" showTickCounter="true" patchSize="17.6" fontSize="10" wrappingAllowedY="true" width="584" tickCounterLabel="Zeittakte" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
