  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="1_transmissibility_x_degree" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go-exp</go>
      <exitCondition><![CDATA[not bank-alive? or ticks-since-shock >= 400]]></exitCondition>
      <metrics>
        <metric>bank-alive?</metric>
        <metric>clean-run?</metric>
        <metric>withdrawn-at-shock</metric>
        <metric>peak-withdrawn</metric>
        <metric>ticks-since-shock</metric>
